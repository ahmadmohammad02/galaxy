<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="230dp"
    android:background="@drawable/movie_poster_focus"
    android:clickable="true"
    android:focusable="true"
    android:nextFocusLeft="@id/movieCategoryList"
    android:foregroundGravity="center">

    <ImageView
        android:id="@+id/moviePosterImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#111827"
        android:contentDescription="Movie poster"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/moviePosterPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="MOVIE"
        android:textColor="#61708B"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/moviePosterRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="#AA07101A"
        android:paddingHorizontal="5dp"
        android:paddingVertical="3dp"
        android:textColor="#FFD447"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/moviePosterTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#D9000000"
        android:ellipsize="end"
        android:maxLines="2"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
</FrameLayout>